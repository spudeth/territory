{
  "name": "territory",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny multiplayer block-claiming game",
  "main": "server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "build": "node --check server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\" \"plugins/*/test/*.test.js\"",
    "backup": "node scripts/backup.js",
    "create-map": "node scripts/create-map.js",
    "sync-rules": "node scripts/sync-rules.js",
    "admin": "node scripts/admin.js"
  },
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "compression": "1.8.1",
    "express": "^4.21.2",
    "jose": "6.2.5",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@neon/config": "^1.9.5",
    "puppeteer-core": "^23.11.1",
    "socket.io-client": "^4.8.1"
  }
}
